# Normalize line endings to LF on commit (cross-platform safe)
* text=auto eol=lf

# Explicitly binary — no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.db binary
*.sqlite binary
